# Data — large, regenerable, never commit
data/raw/
data/features/

# Models — ubm.pkl and speaker_split.pkl are committed so the test suite and
# `selftest` run without downloading the dataset. Regenerated artifacts are not.
# Per-speaker voice models: biometric data, never commit
models/speakers/
# Cohort models are rebuilt by `calibrate`
models/cohort_models.pkl

# Outputs — scalar artifacts stay committed (the tests read them); run logs do not
outputs/*.log

# Python
__pycache__/
.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Environments
.venv/
venv/

# OS
.DS_Store
Thumbs.db
